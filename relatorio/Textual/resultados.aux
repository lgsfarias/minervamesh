\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces Transferência de calor transiente 2D com os parâmetros da Tabela~\ref {tab:val_transcalor_params}, em $t = 0{,}049$~s: o campo $T(x,y)$ mostra a perturbação térmica propagando-se a partir da parede aquecida (topo, $T_{\mathrm  {top}} = 100$°C) e da parede morna (base, $T_{\mathrm  {bot}} = 30$°C) para o interior da placa, ainda inicialmente em $T = 0$°C. O \emph  {colormap} jet varre a faixa de temperatura instantânea e exibe a natureza bidimensional da difusão: a frente de calor do topo penetra mais rapidamente que a da base devido ao maior gradiente $\Delta T$.}}{75}{figure.caption.93}\protected@file@percent }
\newlabel{fig:val_transcalor}{{6.7}{75}{Transferência de calor transiente 2D com os parâmetros da Tabela~\ref {tab:val_transcalor_params}, em $t = 0{,}049$~s: o campo $T(x,y)$ mostra a perturbação térmica propagando-se a partir da parede aquecida (topo, $T_{\mathrm {top}} = 100$°C) e da parede morna (base, $T_{\mathrm {bot}} = 30$°C) para o interior da placa, ainda inicialmente em $T = 0$°C. O \emph {colormap} jet varre a faixa de temperatura instantânea e exibe a natureza bidimensional da difusão: a frente de calor do topo penetra mais rapidamente que a da base devido ao maior gradiente $\Delta T$}{figure.caption.93}{}}
