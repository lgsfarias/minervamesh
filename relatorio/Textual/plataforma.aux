\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Tempo total do solver (mediana, com MAD reportado abaixo de 1\% em todas as células) em CPython nativo e Pyodide (navegador), na mesma máquina (Apple M1 Max). $t_{\text  {mont}}$ é o tempo de montagem (incluindo geração de malha quando aplicável) e $t_{\text  {slv}}$ é o tempo da resolução linear (\texttt  {np.linalg.solve} no caso 1D denso, ou o total dos passos de \texttt  {spsolve} nos casos 2D esparsos). ``CP'' = CPython nativo; ``Py'' = Pyodide.}}{33}{table.caption.59}\protected@file@percent }
\newlabel{tab:benchmark_runtimes}{{4.2}{33}{Tempo total do solver (mediana, com MAD reportado abaixo de 1\% em todas as células) em CPython nativo e Pyodide (navegador), na mesma máquina (Apple M1 Max). $t_{\text {mont}}$ é o tempo de montagem (incluindo geração de malha quando aplicável) e $t_{\text {slv}}$ é o tempo da resolução linear (\texttt {np.linalg.solve} no caso 1D denso, ou o total dos passos de \texttt {spsolve} nos casos 2D esparsos). ``CP'' = CPython nativo; ``Py'' = Pyodide}{table.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Escalabilidade do tempo total do solver com o número de nós, em escala log-log, comparando CPython nativo (linha sólida) e Pyodide no navegador (linha tracejada). À esquerda, condução 1D MEF (denso) com inclinação compatível com $\mathcal  {O}(N^3)$; à direita, transcalor 2D MEF (esparso, 50 passos) com inclinação próxima de $\mathcal  {O}(N^{1{,}2})$.}}{34}{figure.caption.60}\protected@file@percent }
\newlabel{fig:benchmark_scaling}{{4.2}{34}{Escalabilidade do tempo total do solver com o número de nós, em escala log-log, comparando CPython nativo (linha sólida) e Pyodide no navegador (linha tracejada). À esquerda, condução 1D MEF (denso) com inclinação compatível com $\mathcal {O}(N^3)$; à direita, transcalor 2D MEF (esparso, 50 passos) com inclinação próxima de $\mathcal {O}(N^{1{,}2})$}{figure.caption.60}{}}
