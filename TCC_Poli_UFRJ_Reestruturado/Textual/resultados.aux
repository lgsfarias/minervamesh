\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Convecção-difusão 1D com SUPG ativo em $\mathrm  {Pe}_e = 0{,}5$. Painel superior: temperatura $T(x)$ --- pontos azuis para o MEF e linha tracejada vermelha para a solução analítica, visualmente coincidentes em toda a malha. Painel inferior: erro absoluto $|T^{\mathrm  {MEF}} - T^{\mathrm  {ana}}|$ em escala logarítmica, com máximo $4{,}44 \times 10^{-16}$~°C --- precisão de máquina.}}{36}{figure.caption.55}\protected@file@percent }
\newlabel{fig:val_convdif_supg}{{4.3}{36}{Convecção-difusão 1D com SUPG ativo em $\mathrm {Pe}_e = 0{,}5$. Painel superior: temperatura $T(x)$ --- pontos azuis para o MEF e linha tracejada vermelha para a solução analítica, visualmente coincidentes em toda a malha. Painel inferior: erro absoluto $|T^{\mathrm {MEF}} - T^{\mathrm {ana}}|$ em escala logarítmica, com máximo $4{,}44 \times 10^{-16}$~°C --- precisão de máquina}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Convecção-difusão 1D com Galerkin clássico (SUPG desativado), mesmos parâmetros da figura anterior. O painel superior mostra ainda concordância visual em escala linear; o painel inferior de erro revela, entretanto, crescimento exponencial do desvio em direção à camada-limite ($x \to L$), atingindo máximo $3{,}39 \times 10^{-2}$~°C próximo ao contorno direito.}}{37}{figure.caption.56}\protected@file@percent }
\newlabel{fig:val_convdif_galerkin}{{4.4}{37}{Convecção-difusão 1D com Galerkin clássico (SUPG desativado), mesmos parâmetros da figura anterior. O painel superior mostra ainda concordância visual em escala linear; o painel inferior de erro revela, entretanto, crescimento exponencial do desvio em direção à camada-limite ($x \to L$), atingindo máximo $3{,}39 \times 10^{-2}$~°C próximo ao contorno direito}{figure.caption.56}{}}
\citation{Christie1976}
